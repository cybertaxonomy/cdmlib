<?xml version="1.0" encoding="UTF-8"?>
<config
    xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xmlns='http://www.ehcache.org/v3'
    xsi:schemaLocation="http://www.ehcache.org/v3 https://www.ehcache.org/schema/ehcache-core-3.10.xsd">

  <!-- OAI-PMH resumption tokens (Spring Cache / JCache) -->
  <cache alias="eu.etaxonomy.cdm.remote.controller.TaxonOaiPmhController.resumptionToken">
    <key-type>java.lang.Object</key-type>
    <value-type>java.lang.Object</value-type>
    <expiry>
      <ttl unit="hours">2</ttl>
    </expiry>
    <resources>
      <heap unit="entries">1000</heap>
    </resources>
  </cache>

</config>
