  <modelVersion>4.0.0</modelVersion>
  <artifactId>cdmlib-spring-remoting</artifactId>
  <name>CDM Spring Remoting (HttpInvoker)</name>
  <description>
    Spring Framework 5.3 HttpInvoker remoting support, vendored and adapted for Jakarta Servlet / Spring 6.
    Spring Framework 6 removed org.springframework.remoting; this module restores the HttpInvoker API
    used by cdmlib services and TaxEditor.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
